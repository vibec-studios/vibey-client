{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "The Vibe Craft Studios client: social, cosmetics, emotes, multiplayer hosting and lyrics in one modular mod.",
  "authors": [
    "Vibe Craft Studios"
  ],
  "contact": {
    "sources": "https://github.com/vibec-studios/vibey-client",
    "issues": "https://github.com/vibec-studios/vibey-client/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/vibeyclient/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.henny.vibeyclient.fabric.VibeyFabric"
    ],
    "client": [
      "dev.henny.vibeyclient.fabric.VibeyFabricClient"
    ]
  },
  "mixins": [
    "vibeyclient.mixins.json",
    "vibeyclient.social.mixins.json",
    "vibeyclient.multiplayer.mixins.json",
    "vibeyclient.media.lyrics.mixins.json",
    "vibeyclient.pvp.mixins.json",
    "vibeyclient.hud.mixins.json",
    "vibeyclient.clips.mixins.json",
    "vibeyclient.info.mixins.json",
    "vibeyclient.camera.mixins.json",
    "vibeyclient.cinematic.mixins.json",
    "vibeyclient.visuals.mixins.json",
    "vibeyclient.visuals.items.mixins.json",
    "vibeyclient.visuals.effects.mixins.json",
    "vibeyclient.inventory.mixins.json",
    "vibeyclient.servers.mixins.json",
    "vibeyclient.screens.mixins.json",
    "vibeyclient.devlink.mixins.json",
    "vibeyclient.nametags.mixins.json",
    "vibeyclient.chat.mixins.json",
    "vibeyclient.social.streamer.mixins.json",
    "vibeyclient.skins.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=${java}",
    "vui": ">=${vui_version}",
    "r3": ">=${r3_version}",
    "cosmetico": ">=${cosmetico_version}"
  }
}
