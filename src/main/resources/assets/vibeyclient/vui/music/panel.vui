<template>
  <row class="music" gap="6">
    <stack class="art">
      <image v-if="hasCover" class="cover" src="vibeyclient:music/cover"/>
      <text v-if="!hasCover" class="note">♫</text>
    </stack>
    <column class="info" gap="2">
      <text class="title">{{ title }}</text>
      <text class="artist">{{ artist }}</text>
      <progress class="bar" :value="progress"/>
      <row class="keys" gap="4">
        <text class="time">{{ time }}</text>
        <spacer/>
        <button id="previous" class="key" @click="previous()" :tooltip="t('tip.previous')">⏮</button>
        <button id="play" class="key main" @click="toggle()" :tooltip="t(playing ? 'tip.pause' : 'tip.play')">{{ playing ? '❚❚' : '▶' }}</button>
        <button id="next" class="key" @click="next()" :tooltip="t('tip.next')">⏭</button>
        <button id="close" class="key shut" @click="close()" :tooltip="t('tip.close')">✕</button>
      </row>
    </column>
  </row>
</template>
<style>
.music { padding: 6; background: alpha($panel, .9); gradient-to: alpha(mix($panel, $brand, .12), .94); border: 1 alpha($brand, .33); align: center; }
.art { size: 48; background: alpha($text, .06); justify: center; align: center; }
.cover { size: 48; }
.note { color: $brand; font-scale: 2; }
.info { flex-grow: 1; }
.title { color: $text; font-weight: bold; text-wrap: nowrap; text-overflow: ellipsis; }
.artist { color: $muted; text-wrap: nowrap; text-overflow: ellipsis; }
.bar { height: 3; accent: $brand; }
.keys { align: center; }
.time { color: $dim; font-scale: 0.75; text-wrap: nowrap; }
.key { size: 16 14; padding: 0; background: alpha($text, .06); border: 1 $line; color: $text; justify: center; align: center; }
.key:hover { background: $brand; border-color: $brand-hover; color: $on-brand; transition: background 100ms out; }
.key:active { background: mix($brand, $on-brand, .25); color: $on-brand; }
.key.main { width: 20; }
.key.shut { color: $muted; }
.key.shut:hover { background: $danger; border-color: $danger; color: $bg; }
</style>
