<import name="menu-header" src="vibeyclient:menu/header"/>
<import name="module-grid" src="vibeyclient:menu/module-grid"/>
<import name="module-page" src="vibeyclient:menu/module-page"/>
<import name="friends-panel" src="vibeyclient:menu/friends"/>
<contract>
{
  "fields": {
    "view": "string", "panel": "string", "query": "string", "status": "string", "statusLabel": "string",
    "statusTip": "string", "requests": "number", "modules": "list", "creators": "list", "showCreators": "bool",
    "page?": "object", "moreOpen": "bool", "quick": "list", "quickMore": "list", "quickMoreOpen": "bool",
    "notices?": "list", "version": "string", "account": "object", "statusOptions": "list", "friendsOnline": "list",
    "friendsOffline": "list", "showOffline": "bool", "adding": "bool", "addName": "string"
  },
  "actions": ["open(m)", "toggled(m)", "back", "run(row)", "close", "openWardrobe", "openHud", "link(id)", "showWelcome",
              "openInbox", "chat(f)", "invite(f)", "join(f)", "addFriend(name)", "openAccount", "goOnline", "signIn", "retry",
              "openNotice(n)", "dismissNotice(n)"]
}
</contract>
<template>
  <stack class="scrim">
    <column class="shell">
      <menu-header/>
      <stack class="body">
        <module-grid v-if="view == 'grid'"/>
        <module-page v-else/>
        <friends-panel v-if="panel == 'friends'"/>
      </stack>
    </column>
  </stack>
</template>
<style>
.scrim { background: alpha($bg, .6); padding: 8; }
.shell { background: $surface; border: 1 $line2; }
.body { grow: 1; align-items: stretch; }
</style>
