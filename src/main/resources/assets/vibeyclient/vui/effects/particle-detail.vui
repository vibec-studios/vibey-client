<import name="ico" src="vibeyclient:components/ico"/>
<import name="icon-button" src="vibeyclient:components/icon-button"/>
<props>{ "d": {} }</props>
<template>
  <column id="fx-detail" class="fx-det">
    <row class="fx-det-bar">
      <icon-button id="fx-back" icon="back" :tip="t('visuals.effects.ui.back')" @click="back()"/>
      <stack class="fx-big">
        <image v-if="sprite(d.id, frame)" :src="sprite(d.id, frame)" tinted
               :style="{ color: d.swatchColor, width: d.swatchPx, height: d.swatchPx }"/>
      </stack>
      <text class="fx-det-name" :tooltip="d.id">{{ d.name }}</text>
      <spacer/>
      <icon-button id="fx-reset" icon="reset" :tip="t('visuals.effects.ui.reset')" @click="resetSel()"/>
    </row>
    <column class="fx-det-body">
      <row class="fx-field">
        <text class="fx-label">{{ t('visuals.effects.ui.amount') }}</text>
        <slider id="fx-amount" class="fx-slider" v-model="d.amount" min="0" max="400" step="10"/>
        <text class="fx-num">{{ d.amountText }}</text>
      </row>
      <row class="fx-field">
        <text class="fx-label">{{ t('visuals.effects.ui.size') }}</text>
        <slider id="fx-size" class="fx-slider" v-model="d.size" min="25" max="300" step="5"/>
        <text class="fx-num">{{ d.sizeText }}</text>
      </row>
      <row class="fx-field">
        <text class="fx-label">{{ t('visuals.effects.ui.color') }}</text>
        <colorpicker id="fx-tint" v-model="d.tint" :presets="tints"/>
        <slider id="fx-strength" class="fx-slider-s" v-model="d.strength" min="0" max="100" step="5"
                :tooltip="t('visuals.effects.ui.strength')"/>
        <text class="fx-num">{{ d.strengthText }}</text>
      </row>
      <row class="fx-field">
        <text class="fx-label">{{ t('visuals.effects.ui.hide') }}</text>
        <spacer/>
        <toggle id="fx-hidden" v-model="d.hidden"/>
      </row>
      <button id="fx-burst" class="primary fx-burst" :disabled="!d.testable"
              :tooltip="d.testable ? '' : t('visuals.effects.ui.noTest')" @click="burst()">
        <ico name="play"/><text>{{ t('visuals.effects.ui.test') }}</text>
      </button>
    </column>
  </column>
</template>
<style>
.fx-det { grow: 1; min-height: 0; align-items: stretch; }
.fx-det-bar { height: 22; gap: 4; padding: 0 4 0 3; border-bottom: 1 $line; flex-shrink: 0; }
.fx-big { size: 18; align-items: center; justify: center; background: $surface; flex-shrink: 0; }
.fx-det-name { color: $text; font-weight: bold; min-width: 0; text-wrap: nowrap; text-overflow: ellipsis; }
.fx-det-body { padding: 6; gap: 4; align-items: stretch; }
.fx-field { height: 16; gap: 4; }
.fx-label { width: 62; color: $text; text-wrap: nowrap; text-overflow: ellipsis; }
.fx-slider { grow: 1; }
.fx-slider-s { grow: 1; }
.fx-num { width: 28; color: $muted; text-align: end; text-wrap: nowrap; }
.fx-burst { height: 18; gap: 4; margin-top: 4; }
</style>
