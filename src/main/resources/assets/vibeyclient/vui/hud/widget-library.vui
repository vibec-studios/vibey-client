<import name="ico" src="vibeyclient:components/ico"/>
<import name="icon-button" src="vibeyclient:components/icon-button"/>
<template>
  <column class="lib">
    <grid class="lib-grid" columns="2" gap="2">
      <row v-for="w in widgets" :key="w.id" :id="'lib-' + w.id" class="lib-item" :class="{ on: w.on, off: w.locked }" :tooltip="w.tip">
        <toggle :value="w.on" @change="placed(w, $event)"/>
        <text class="lib-name">{{ w.name }}</text>
        <ico v-if="w.locked" name="lock" class="lib-lock"/>
        <icon-button v-if="w.canAdd" icon="plus" class="lib-add" :tip="t('ui.hud.addCopy')" @click="addCopy(w)"/>
      </row>
    </grid>
  </column>
</template>
<style>
.lib { width: 236; padding: 2; }
.lib-item { height: 16; gap: 5; padding: 0 2 0 4; }
.lib-item:hover { background: $surface2; }
.lib-name { grow: 1; min-width: 0; color: $muted; text-wrap: nowrap; text-overflow: ellipsis; }
.lib-item.on .lib-name { color: $text; }
.lib-item.off .lib-name { color: $dim; }
.lib-lock { color: $danger; }
.lib-add { size: 14; }
</style>
