<template>
  <column id="toasts">
    <toast v-for="t in toasts" :key="t.id" :class="t.kind" @click="dismiss(t)">
      <stack class="toast-icon"><icon v-if="t.icon" :src="t.icon"/></stack>
      <column class="toast-body">
        <text class="toast-title">{{ t.title }}</text>
        <text v-if="t.text" class="toast-text">{{ t.text }}</text>
      </column>
      <button v-if="t.action" class="toast-action" @click.stop="act(t)">{{ t.action }}</button>
    </toast>
  </column>
</template>
<style>
#toasts { position: absolute; anchor: bottom-right; right: 6; bottom: 6; gap: 3; align-items: end; }
toast { min-width: 0; width: 176; height: 22; padding: 0 4 0 0; gap: 5; background: $surface; border: 1 $line2; cursor: pointer;
        transition: opacity 150ms out, translate-y 150ms out; }
toast:enter, toast:leave { opacity: 0; translate-y: 8; }
.toast-icon { width: 20; align-self: stretch; align-items: center; background: $surface3; color: $brand2; }
toast.ok .toast-icon { color: $ok; }
toast.warn .toast-icon { color: $warn; }
toast.error .toast-icon { color: $danger; }
toast.invite .toast-icon { background: $brand; color: #ffffff; }
.toast-body { grow: 1; min-width: 0; gap: 1; }
.toast-title { color: $text; text-wrap: nowrap; text-overflow: ellipsis; }
.toast-text { color: $dim; font-scale: 0.75; text-wrap: nowrap; text-overflow: ellipsis; }
.toast-action { height: 14; padding: 0 5; }
toast.invite .toast-action { background: $brand; border-color: $brand; color: #ffffff; }
</style>
