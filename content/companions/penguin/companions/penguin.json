{
  "id": "penguin",
  "name": "@penguin.name",
  "description": "@penguin.description",
  "model": "models/penguin.vibey",
  "scale": 0.6,
  "size": { "default": 1.0, "min": 0.6, "max": 1.4 },
  "box": { "width": 0.5, "height": 0.85 },
  "variants": [
    { "id": "classic", "name": "@variant.classic" },
    { "id": "emperor", "name": "@variant.emperor", "textures": { "main": "textures/penguin_emperor.png" } },
    { "id": "rockhopper", "name": "@variant.rockhopper", "textures": { "main": "textures/penguin_rockhopper.png" } }
  ],
  "animations": {
    "idle": "idle", "walk": "walk", "run": "sprint", "swim": "swim", "swim_idle": "swim_idle",
    "fall": "glide", "sit": "sit", "sleep": "sleep", "held": "held", "ride": "sit"
  },
  "look": { "bone": "head", "maxYaw": 60, "maxPitch": 30, "speed": 240 },
  "movement": {
    "walkSpeed": 2.8, "runSpeed": 6.4, "swimSpeed": 6.5, "canSwim": true, "jump": 1.1, "step": 0.6, "turnSpeed": 300,
    "follow": { "near": 1.7, "far": 4.2, "run": 8.0, "teleport": 24 },
    "wander": 5,
    "shoulder": [0.5, 1.4, 0.1],
    "head": [0, 1.95, 0]
  },
  "props": {
    "umbrella": { "bones": ["umbrella"] },
    "fish": { "bones": ["fish"] },
    "juggle": { "bones": ["fish2", "fish3"] },
    "scarf": { "bones": ["scarf"], "when": "world.cold && !self.inWater" },
    "shades": { "bones": ["shades"], "when": "world.hot && !self.inWater" },
    "fan": { "bones": ["fan"] },
    "sweat": { "bones": ["sweat"] },
    "snowball": { "bones": ["snowball"] },
    "party_hat": { "bones": ["party_hat"] },
    "zzz": { "bones": ["z1", "z2", "z3"] }
  },
  "sounds": {
    "squeak": { "file": "sounds/squeak.ogg", "volume": 0.6, "pitch": [0.92, 1.12] },
    "peep": { "file": "sounds/peep.ogg", "volume": 0.45, "pitch": [0.9, 1.25] },
    "bray": { "file": "sounds/bray.ogg", "volume": 0.6, "pitch": [0.95, 1.1] },
    "coo": { "file": "sounds/coo.ogg", "volume": 0.3, "pitch": [0.9, 1.05] },
    "splash": { "sound": "minecraft:entity.generic.splash", "volume": 0.4, "pitch": [1.2, 1.4] },
    "shake": { "sound": "minecraft:entity.wolf.shake", "volume": 0.45, "pitch": 1.5 },
    "pop": { "sound": "minecraft:entity.chicken.egg", "volume": 0.5, "pitch": 1.7 },
    "poof": { "sound": "minecraft:entity.allay.item_thrown", "volume": 0.4, "pitch": 1.3 },
    "steps": { "sound": "minecraft:block.snow.step", "volume": 0.3, "pitch": 1.4 },
    "eat": { "sound": "minecraft:entity.generic.eat", "volume": 0.35, "pitch": 1.6 },
    "party": { "sound": "minecraft:entity.firework_rocket.twinkle", "volume": 0.35, "pitch": 1.3 },
    "bubbles": { "sound": "minecraft:block.bubble_column.upwards_inside", "volume": 0.3, "pitch": 1.4 },
    "flap": { "sound": "minecraft:entity.parrot.fly", "volume": 0.4, "pitch": 1.2 }
  },
  "particles": {
    "hearts": { "particle": "minecraft:heart", "count": 3, "locator": "heart", "spread": [0.25, 0.1, 0.25], "velocity": [0, 0.04, 0] },
    "splash": { "particle": "minecraft:splash", "count": 16, "locator": "feet", "spread": [0.45, 0.1, 0.45], "velocity": [0, 0.15, 0] },
    "bubbles": { "particle": "minecraft:bubble", "count": 5, "locator": "beak", "spread": [0.2, 0.1, 0.2], "velocity": [0, 0.05, 0] },
    "snow": { "particle": "minecraft:snowflake", "count": 4, "locator": "feet", "spread": [0.3, 0.1, 0.3], "velocity": [0, 0.04, 0] },
    "notes": { "particle": "minecraft:note", "count": 2, "locator": "heart", "spread": [0.3, 0.1, 0.3] },
    "poof": { "particle": "minecraft:poof", "count": 8, "locator": "feet", "spread": [0.3, 0.2, 0.3], "velocity": [0, 0.02, 0] },
    "sparkle": { "particle": "minecraft:happy_villager", "count": 6, "locator": "heart", "spread": [0.4, 0.2, 0.4] },
    "drip": { "particle": "minecraft:dripping_water", "count": 3, "locator": "umbrella", "spread": [0.55, 0.05, 0.55] },
    "confetti": { "particle": "minecraft:totem_of_undying", "count": 18, "locator": "heart", "spread": [0.3, 0.2, 0.3], "velocity": [0, 0.22, 0] },
    "stars": { "particle": "minecraft:end_rod", "count": 2, "locator": "heart", "spread": [0.3, 0.2, 0.3], "velocity": [0, 0.02, 0] }
  },
  "needs": {
    "energy": { "start": 0.9, "perMinute": -0.05 },
    "happiness": { "start": 0.7, "perMinute": -0.03 },
    "curiosity": { "start": 0.5, "perMinute": 0.06 },
    "hunger": { "start": 0.3, "perMinute": 0.025 }
  },
  "vars": { "tricks": 0, "pets": 0, "fish": 0, "umbrella": 0 },
  "tricks": [
    { "id": "spin", "name": "@trick.spin", "icon": "↻", "behavior": "trick_spin" },
    { "id": "slide", "name": "@trick.slide", "icon": "»", "behavior": "trick_slide" },
    { "id": "wave", "name": "@trick.wave", "icon": "☺", "behavior": "trick_wave" },
    { "id": "bow", "name": "@trick.bow", "icon": "✿", "behavior": "trick_bow" },
    { "id": "juggle", "name": "@trick.juggle", "icon": "✦", "behavior": "trick_juggle" },
    { "id": "dance", "name": "@trick.dance", "icon": "♪", "behavior": "trick_dance" },
    { "id": "up", "name": "@trick.up", "icon": "▲", "behavior": "trick_up" }
  ],
  "behaviors": [
    { "id": "picked_up", "priority": 100, "on": "pick_up", "duration": 1, "obeys": false,
      "start": [ { "do": "sound", "name": "squeak" }, { "do": "say", "text": "@say.wheee", "seconds": 1.5 } ] },
    { "id": "put_down", "priority": 98, "on": "place", "duration": 0.8, "obeys": false, "move": "stay", "anim": "land",
      "start": [ { "do": "particle", "name": "poof" }, { "do": "say", "text": "@say.down", "seconds": 1.5, "at": 0.3 } ] },
    { "id": "renamed", "priority": 96, "on": "rename", "obeys": false, "anim": "flap",
      "start": [ { "do": "particle", "name": "hearts" }, { "do": "say", "text": "@say.renamed" }, { "do": "sound", "name": "bray" } ] },
    { "id": "petted", "priority": 92, "on": "pet", "cooldown": 0.4, "obeys": false, "look": "player", "anim": "flap",
      "start": [
        { "do": "sound", "name": "squeak" },
        { "do": "particle", "name": "hearts" },
        { "do": "say", "text": "@say.pet", "seconds": 2 },
        { "do": "need", "happiness": 0.15 },
        { "do": "var", "name": "pets", "value": "var.pets + 1" },
        { "do": "sound", "name": "flap", "at": 0.2 },
        { "do": "particle", "name": "sparkle", "if": "var.pets % 5 == 0" }
      ] },
    { "id": "hello", "priority": 90, "on": "spawn", "obeys": false, "anim": "wave",
      "start": [ { "do": "particle", "name": "poof" }, { "do": "sound", "name": "bray", "at": 0.2 }, { "do": "say", "text": "@say.hello", "at": 0.2 } ] },
    { "id": "flee_danger", "priority": 88, "obeys": false,
      "when": "near.lava < 3.5 || near.fire < 2.5 || near.mob < 4",
      "while": "near.lava < 6 || near.fire < 4 || near.mob < 6",
      "minDuration": 2, "cooldown": 1, "move": "flee", "look": "move", "anim": "worried",
      "start": [ { "do": "say", "text": "@say.scared", "seconds": 1.5 }, { "do": "sound", "name": "peep", "pitch": 1.6 } ] },
    { "id": "celebrate_level", "priority": 86, "on": "owner_level_up", "obeys": false, "move": "stay", "look": "player",
      "anim": { "name": "celebrate", "blend": "replace" }, "props": { "party_hat": true },
      "start": [ { "do": "sound", "name": "bray" }, { "do": "say", "text": "@say.level" }, { "do": "particle", "name": "confetti", "at": 1.3 }, { "do": "sound", "name": "party", "at": 1.3 } ],
      "end": [ { "do": "need", "happiness": 0.2 } ] },
    { "id": "celebrate_goal", "priority": 86, "on": "owner_advancement", "obeys": false, "move": "stay", "look": "player",
      "anim": { "name": "celebrate", "blend": "replace" }, "props": { "party_hat": true },
      "start": [ { "do": "sound", "name": "bray" }, { "do": "say", "text": "@say.advancement" }, { "do": "particle", "name": "confetti", "at": 1.3 }, { "do": "sound", "name": "party", "at": 1.3 } ],
      "end": [ { "do": "need", "happiness": 0.2 } ] },
    { "id": "thunder_scared", "priority": 85, "on": "thunder_start", "duration": 4, "move": "near", "anim": "shiver",
      "start": [ { "do": "say", "text": "@say.thunder" }, { "do": "sound", "name": "peep", "pitch": 1.8 } ] },
    { "id": "very_worried", "priority": 81, "on": "owner_low_health", "duration": 6, "move": "near", "look": "player", "anim": "worried",
      "start": [ { "do": "say", "text": "@say.low", "seconds": 3 }, { "do": "sound", "name": "peep", "pitch": 0.8 } ],
      "repeat": [ { "every": 1.5, "actions": [ { "do": "particle", "name": "hearts" } ] } ] },
    { "id": "worried", "priority": 80, "on": "owner_hurt", "cooldown": 6, "duration": 2.5, "move": "near", "look": "player", "anim": "worried",
      "start": [ { "do": "say", "text": "@say.hurt", "seconds": 2 }, { "do": "sound", "name": "peep", "pitch": 0.9 } ] },
    { "id": "dive", "priority": 78, "on": "enter_water", "cooldown": 4, "duration": 1.4,
      "start": [ { "do": "particle", "name": "splash" }, { "do": "sound", "name": "splash" }, { "do": "particle", "name": "bubbles", "at": 0.4 },
                 { "do": "sound", "name": "bubbles", "at": 0.4 }, { "do": "say", "text": "@say.splash", "chance": 0.5 } ] },
    { "id": "shake_off", "priority": 76, "on": "leave_water", "cooldown": 6, "move": "stay", "obeys": false, "anim": "flap", "duration": 1.2,
      "start": [ { "do": "sound", "name": "shake", "at": 0.1 }, { "do": "particle", "name": "splash", "at": 0.2 }, { "do": "need", "happiness": 0.05 } ] },
    { "id": "umbrella_close", "priority": 74, "on": "rain_stop", "when": "var.umbrella > 0 && !self.inWater", "obeys": false, "move": "stay",
      "anim": "umbrella_close", "props": { "umbrella": true },
      "start": [ { "do": "var", "name": "umbrella", "value": 0 }, { "do": "say", "text": "@say.dry", "at": 1.6 } ] },
    { "id": "ok_sit", "priority": 72, "on": "command_sit", "anim": "bow",
      "start": [ { "do": "sound", "name": "peep" }, { "do": "say", "text": "@say.ok", "seconds": 1.5 } ] },
    { "id": "ok_follow", "priority": 72, "on": "command_follow", "anim": "flap",
      "start": [ { "do": "sound", "name": "squeak" }, { "do": "say", "text": "@say.ok", "seconds": 1.5 } ] },
    { "id": "ok_stay", "priority": 72, "on": "command_stay", "anim": "wave",
      "start": [ { "do": "say", "text": "@say.stay", "seconds": 1.5 } ] },
    { "id": "trick_spin", "priority": 66, "obeys": false, "move": "stay", "cooldown": 1, "anim": { "name": "spin", "blend": "replace" },
      "start": [ { "do": "sound", "name": "peep", "at": 0.2 }, { "do": "sound", "name": "steps", "at": 1.4 } ],
      "end": [ { "do": "say", "text": "@say.tada", "chance": 0.6 }, { "do": "var", "name": "tricks", "value": "var.tricks + 1" }, { "do": "need", "happiness": 0.05 } ] },
    { "id": "trick_slide", "priority": 66, "obeys": false, "move": "circle", "duration": 4.5, "cooldown": 2,
      "anim": { "name": "sprint", "blend": "replace", "fade": 0.25 },
      "start": [ { "do": "say", "text": "@say.wheee" }, { "do": "sound", "name": "squeak" } ],
      "repeat": [ { "every": 0.5, "actions": [ { "do": "particle", "name": "snow" } ] } ],
      "end": [ { "do": "say", "text": "@say.tada", "chance": 0.5 }, { "do": "need", "happiness": 0.08, "energy": -0.05 } ] },
    { "id": "trick_wave", "priority": 66, "obeys": false, "look": "player", "anim": "wave",
      "start": [ { "do": "say", "text": "@say.hello" }, { "do": "sound", "name": "peep" } ] },
    { "id": "trick_bow", "priority": 66, "obeys": false, "move": "stay", "look": "player", "anim": { "name": "bow", "blend": "replace" },
      "start": [ { "do": "say", "text": "@say.bow", "at": 0.5 } ],
      "end": [ { "do": "sound", "name": "squeak" } ] },
    { "id": "trick_juggle", "priority": 66, "obeys": false, "move": "stay", "look": "player", "cooldown": 2,
      "anim": { "name": "juggle", "blend": "replace" }, "props": { "fish": true, "juggle": true },
      "start": [ { "do": "sound", "name": "pop", "at": 0.3 }, { "do": "sound", "name": "pop", "at": 1.5 }, { "do": "sound", "name": "pop", "at": 2.7 } ],
      "end": [ { "do": "particle", "name": "sparkle" }, { "do": "say", "text": "@say.tada" }, { "do": "sound", "name": "bray" }, { "do": "var", "name": "tricks", "value": "var.tricks + 1" }, { "do": "need", "happiness": 0.1 } ] },
    { "id": "trick_dance", "priority": 66, "obeys": false, "move": "stay", "duration": 4.8, "cooldown": 1, "anim": { "name": "dance", "blend": "replace" },
      "repeat": [ { "every": 0.6, "actions": [ { "do": "particle", "name": "notes" } ] } ],
      "end": [ { "do": "say", "text": "@say.tada", "chance": 0.5 }, { "do": "need", "happiness": 0.08 } ] },
    { "id": "trick_up", "priority": 66, "obeys": false, "move": "head", "duration": [12, 20], "look": "around",
      "start": [ { "do": "say", "text": "@say.up" } ],
      "end": [ { "do": "say", "text": "@say.down", "chance": 0.5 } ] },
    { "id": "slip", "priority": 64, "when": "self.onIce && self.moving && chance(0.05)", "cooldown": 30, "obeys": false, "move": "stay",
      "anim": { "name": "slip", "blend": "replace" },
      "start": [ { "do": "say", "text": "@say.oops", "at": 0.6 }, { "do": "sound", "name": "peep", "at": 0.4, "pitch": 1.7 } ],
      "end": [ { "do": "need", "happiness": -0.02 } ] },
    { "id": "boat_ride", "priority": 62, "when": "player.riding && player.distance < 10 && !self.held", "while": "player.riding",
      "minDuration": 2, "move": "head", "look": "around",
      "start": [ { "do": "say", "text": "@say.boat" }, { "do": "sound", "name": "bray" } ],
      "repeat": [ { "every": [10, 18], "actions": [ { "do": "say", "text": "@say.boat", "chance": 0.4 } ] } ] },
    { "id": "umbrella", "priority": 60, "when": "weather.rain && !weather.snow && world.sky && !self.inWater", "while": "weather.rain && !self.inWater",
      "minDuration": 4, "props": { "umbrella": true }, "anim": "umbrella_open",
      "start": [ { "do": "var", "name": "umbrella", "value": 1 }, { "do": "say", "text": "@say.rain", "chance": 0.7, "at": 1.0 } ],
      "repeat": [
        { "every": [1.5, 3], "actions": [ { "do": "particle", "name": "drip" } ] },
        { "every": [7, 12], "actions": [ { "do": "random", "of": [
          [ { "do": "anim", "name": "umbrella_twirl" }, { "do": "sound", "name": "peep" } ],
          [ { "do": "anim", "name": "look_up" } ],
          [ { "do": "say", "text": "@say.rain" } ] ] } ] }
      ] },
    { "id": "snow_play", "priority": 58, "when": "(weather.snow || self.onSnow) && !self.moving && need.energy > 0.3 && chance(0.08)",
      "cooldown": 25, "move": "stay", "look": "player", "props": { "snowball": true }, "anim": { "name": "snow_play", "blend": "replace" },
      "start": [ { "do": "sound", "name": "steps", "at": 0.5 }, { "do": "sound", "name": "squeak", "at": 2.7 } ],
      "end": [ { "do": "say", "text": "@say.snow", "chance": 0.6 }, { "do": "need", "happiness": 0.1, "energy": -0.03 } ] },
    { "id": "hot_fan", "priority": 57, "when": "world.hot && !self.inWater && chance(0.15)", "duration": [6, 10], "cooldown": 14,
      "props": { "fan": true, "sweat": true }, "anim": "fanning",
      "start": [ { "do": "say", "text": "@say.hot", "chance": 0.6 } ],
      "needs": { "happiness": -0.05 } },
    { "id": "cold_huddle", "priority": 56, "when": "world.cold && !self.moving && !self.inWater && chance(0.1)", "duration": [5, 8], "cooldown": 20,
      "move": "near", "anim": "shiver",
      "start": [ { "do": "say", "text": "@say.cold", "chance": 0.4 } ],
      "repeat": [ { "every": [1.5, 2.5], "actions": [ { "do": "particle", "name": "snow" } ] } ] },
    { "id": "dance_music", "priority": 54, "when": "world.music && player.distance < 16 && !self.inWater", "while": "world.music",
      "minDuration": 2, "move": "near", "look": "player", "anim": { "name": "dance", "blend": "replace" },
      "start": [ { "do": "say", "text": "@say.music" }, { "do": "sound", "name": "squeak" } ],
      "repeat": [ { "every": 0.8, "actions": [ { "do": "particle", "name": "notes" } ] } ],
      "needs": { "happiness": 0.3 } },
    { "id": "belly_slide", "priority": 52, "when": "self.moving && !self.inWater && (self.onSnow || self.onIce || self.climb < -2.5)",
      "minDuration": 0.5, "anim": { "name": "sprint", "blend": "replace", "fade": 0.25 }, "needs": { "happiness": 0.2 },
      "start": [ { "do": "sound", "name": "squeak", "chance": 0.3 } ],
      "repeat": [ { "every": [1, 2], "actions": [ { "do": "sound", "name": "steps" } ] } ] },
    { "id": "swim_along", "priority": 50, "when": "self.inWater && player.inWater", "move": "follow", "look": "move",
      "needs": { "happiness": 0.3 },
      "repeat": [ { "every": [1, 2], "actions": [ { "do": "particle", "name": "bubbles" } ] } ] },
    { "id": "splash_play", "priority": 49, "when": "self.inWater && !player.inWater && player.distance < 9", "move": "swim", "look": "around",
      "needs": { "happiness": 0.25, "hunger": -0.05 },
      "repeat": [
        { "every": [2, 4], "actions": [ { "do": "particle", "name": "bubbles" } ] },
        { "every": [5, 9], "actions": [ { "do": "hop", "height": 0.6 }, { "do": "particle", "name": "splash", "at": 0.5 }, { "do": "sound", "name": "splash", "at": 0.5 } ] }
      ] },
    { "id": "beg_fish", "priority": 48, "when": "holding('minecraft:cod', 'minecraft:salmon', 'minecraft:cooked_cod', 'minecraft:cooked_salmon', 'minecraft:tropical_fish', 'minecraft:fishing_rod') && player.distance < 7",
      "move": "near", "look": "player", "anim": "worried",
      "repeat": [ { "every": [2, 4], "actions": [ { "do": "anim", "name": "flap" }, { "do": "sound", "name": "squeak" }, { "do": "say", "text": "@say.fish", "chance": 0.6 } ] } ] },
    { "id": "go_fishing", "priority": 46, "when": "near.water < 7 && !self.inWater && need.hunger > 0.45 && !time.night && chance(0.05)",
      "while": "player.distance < 14", "duration": [10, 16], "cooldown": 90, "move": "swim", "look": "around", "props": { "fish": true },
      "repeat": [ { "every": [3, 5], "actions": [
        { "do": "anim", "name": "catch_fish", "if": "self.inWater", "chance": 0.7 },
        { "do": "var", "name": "fish", "value": "var.fish + 1", "if": "self.inWater" },
        { "do": "need", "hunger": -0.25, "if": "self.inWater" } ] } ],
      "end": [ { "do": "say", "text": "@say.yum", "if": "var.fish > 0" } ] },
    { "id": "fish_snack", "priority": 47, "when": "near.water < 2.5 && !self.inWater && !self.moving && need.hunger > 0.25 && chance(0.04)",
      "cooldown": 45, "move": "stay", "props": { "fish": true }, "anim": { "name": "catch_fish", "blend": "replace" },
      "start": [ { "do": "sound", "name": "splash", "at": 0.75 }, { "do": "say", "text": "@say.catch", "at": 1.2 } ],
      "end": [ { "do": "need", "hunger": -0.3, "happiness": 0.1 }, { "do": "var", "name": "fish", "value": "var.fish + 1" } ] },
    { "id": "sleep_night", "priority": 45, "when": "(time.night && need.energy < 0.75 || player.sleeping) && !self.inWater && player.distance < 12",
      "while": "(time.night && need.energy < 0.98 || player.sleeping) && player.distance < 12",
      "minDuration": 6, "move": "near", "look": "none", "baseAnim": "sleep", "props": { "zzz": true }, "needs": { "energy": 0.8 },
      "repeat": [
        { "every": [3.5, 6], "actions": [ { "do": "sound", "name": "coo", "if": "!self.moving" } ] },
        { "every": [8, 13], "actions": [ { "do": "say", "text": "@say.sleep", "seconds": 2, "if": "!self.moving", "chance": 0.6 } ] }
      ],
      "end": [ { "do": "anim", "name": "flap" } ] },
    { "id": "nap_afk", "priority": 40, "when": "player.idle > 40 && need.energy < 0.85 && !self.inWater", "while": "player.idle > 5",
      "move": "near", "look": "none", "baseAnim": "idle_long", "props": { "zzz": true }, "needs": { "energy": 0.5 },
